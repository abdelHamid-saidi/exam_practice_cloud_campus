# Copier vers deploy/.env sur le serveur. Ne pas committer le fichier réel.
# Pré-production : ENVIRONMENT=preproduction et HTTP_PORT=8080
# Production : ENVIRONMENT=production et HTTP_PORT=80

BACKEND_IMAGE=ghcr.io/proprietaire/exam_practice_cloud_campus/backend:preprod
FRONTEND_IMAGE=ghcr.io/proprietaire/exam_practice_cloud_campus/frontend:preprod
JWT_SECRET=remplacez-par-une-valeur-aleatoire-d-au-moins-32-caracteres
CORS_ORIGIN=https://preprod.exemple.fr
HTTP_PORT=8080
ENVIRONMENT=preproduction
LOG_LEVEL=info
